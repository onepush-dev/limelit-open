{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:{$PORT} {
	@open path /healthz /mcp /mcp/*
	handle @open {
		reverse_proxy 127.0.0.1:1516
	}
	handle {
		basic_auth {
			{$LIMELIT_USERNAME} {$LIMELIT_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:1516
	}
}
